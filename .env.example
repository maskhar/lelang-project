DATABASE_URL=postgresql://lelang_app:change-me@127.0.0.1:5432/lelang_properti_dev?sslmode=disable
DATABASE_MIGRATION_URL=postgresql://lelang_migrator:change-me@127.0.0.1:5432/lelang_properti_dev?sslmode=disable
AUTH_SESSION_COOKIE_NAME=lelang_session
AUTH_CSRF_SECRET=
AUTH_RATE_LIMIT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Wajib: APP_BASE_URL dan STORAGE_ROOT (path absolut di luar repo). Notifikasi dikirim lewat webhook
# (dashboard admin -> Webhook), bukan email; METRICS_TOKEN mengaktifkan /api/v1/health/metrics.
APP_BASE_URL=http://localhost:3000
STORAGE_ROOT=
METRICS_TOKEN=
BACKUP_ROOT=

# Opsional: nomor WhatsApp tombol kontak di detail properti. Kosong = pakai default di src/lib/contact.ts.
WHATSAPP_NUMBER=

# Opsional: kunci AES-256-GCM (hex 64 karakter) untuk enkripsi secret webhook lead->n8n di dashboard admin.
# Kosong = fitur webhook mengembalikan 503 WEBHOOK_KEY_MISSING, fitur lain tetap normal.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENC_KEY=
