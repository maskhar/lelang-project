# Salin ke .env.docker.local lalu isi. File .env.docker.local diabaikan git (.env*); jangan commit.
# Secret hex: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# --- PostgreSQL produksi (container terpisah dari database development di port 15432) ---
POSTGRES_DB=lelang_properti_prod
POSTGRES_PORT=15433
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=

# --- Next.js ---
# Port host (bind 127.0.0.1). 3009 belum dipakai container lain di mesin ini.
APP_PORT=3009
# Wajib HTTPS untuk domain non-localhost; TLS diakhiri oleh tunnel/reverse proxy, container tetap HTTP.
APP_BASE_URL=https://ganti-dengan-domain-anda
AUTH_SESSION_COOKIE_NAME=lelang_session
AUTH_CSRF_SECRET=
AUTH_RATE_LIMIT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus persis APP_BASE_URL + /api/v1/auth/google/callback dan terdaftar di Google Cloud Console.
GOOGLE_REDIRECT_URI=https://ganti-dengan-domain-anda/api/v1/auth/google/callback

# --- SMTP untuk worker outbox (produksi mewajibkan STARTTLS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ganti-dengan-domain-anda
NOTIFICATION_EMAIL=

# Opsional: mengaktifkan GET /api/v1/health/metrics dengan header Authorization: Bearer <token>.
METRICS_TOKEN=

# --- Path host (absolut, di luar repository) yang di-mount ke /data/storage container ---
# Windows contoh: I:/website-devops/lelang-storage-prod
STORAGE_HOST_PATH=
