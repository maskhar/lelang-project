{
  "name": "lelang-properti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "backend:setup": "node scripts/setup-local-backend.mjs",
    "backend:up": "docker compose --env-file .env.backend.local -f compose.backend.yml up -d",
    "backend:down": "docker compose --env-file .env.backend.local -f compose.backend.yml down",
    "db:grant:local": "node scripts/grant-runtime.mjs",
    "user:approve": "node scripts/manage-local-user.mjs approve",
    "user:disable": "node scripts/manage-local-user.mjs disable",
    "user:enable": "node scripts/manage-local-user.mjs enable",
    "user:role": "node scripts/manage-local-user.mjs role",
    "dev:seed-roles": "node scripts/seed-dev-roles.mjs",
    "docker:up": "docker compose --env-file .env.docker.local up -d --build",
    "docker:down": "docker compose --env-file .env.docker.local down",
    "docker:logs": "docker compose --env-file .env.docker.local logs -f --tail=200",
    "docker:migrate": "node scripts/migrate-docker.mjs",
    "docker:grant": "node scripts/grant-runtime-docker.mjs",
    "docker:user:approve": "node scripts/manage-user-docker.mjs approve",
    "docker:user:disable": "node scripts/manage-user-docker.mjs disable",
    "docker:user:enable": "node scripts/manage-user-docker.mjs enable",
    "docker:user:role": "node scripts/manage-user-docker.mjs role",
    "test:auth": "node scripts/test-auth.mjs",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "worker:outbox": "node --conditions=react-server --import=tsx scripts/run-worker.ts",
    "backup:local": "node scripts/backup-local.mjs",
    "test:restore": "node scripts/test-restore-local.mjs",
    "test:load": "node scripts/load-local.mjs",
    "test": "node --conditions=react-server --import=tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@next/swc-win32-x64-msvc": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
